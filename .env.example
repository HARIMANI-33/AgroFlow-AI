# ==============================================
# AGROFLOW AI - Environment Configuration Example
# Copy this file to .env and configure local values
# ==============================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration (Planned)
DATABASE_URL=postgresql://user:password@localhost:5432/agroflow_db

# Security & Authentication (Planned)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External APIs & Services (Planned)
MARKET_PRICE_API_KEY=your_market_price_api_key_here
AI_SERVICE_API_KEY=your_ai_api_key_here
