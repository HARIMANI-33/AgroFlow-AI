# ==========================================
# AGROFLOW AI - Backend Environment Example
# Copy this file to .env and configure values
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="AGROFLOW AI Backend"

# CORS Configuration (Allowed origins separated by comma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/agroflow_db

# Security & Authentication (JWT)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
